{
  "manifest_version": 3,
  "name": "Licence Operations Desk",
  "version": "1.0.4",
  "description": "A local, attention-first workspace for managing public Washington gambling-license records.",
  "action": {
    "default_title": "Open Licence Operations Desk",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://myaccount.wsgc.wa.gov/*"]
}
